# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Secrets — never commit API keys
.env

# Runtime data (session store, logs, auto-created skills/memory)
harness.db
harness.db-*
harness.log
harness.trace.jsonl
# Anchored to the repo root: the runtime skills/memory dirs at cwd. The
# unanchored "skills/" also matched src/harness/skills/ (any depth), which
# would have hidden the bundled skills that ship in the package source.
/skills/
/memory/
