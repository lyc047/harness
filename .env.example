# Copy to `.env` and fill in real values.
# LLM provider (DeepSeek is OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Loop behaviour
HARNESS_MAX_TURNS=30
HARNESS_REQUEST_TIMEOUT=60
HARNESS_RETRY_ATTEMPTS=3

# Storage
HARNESS_DB_PATH=harness.db

# Sandbox (P7) — ssh | http | local
HARNESS_SANDBOX_MODE=local
# SANDBOX_HOST=
# SANDBOX_PORT=22
# SANDBOX_USER=
# SANDBOX_KEY_PATH=
# SANDBOX_WORKDIR=~/harness-workspace

# Logging / tracing
HARNESS_LOG_LEVEL=INFO
HARNESS_LOG_FILE=harness.log
HARNESS_TRACE_FILE=harness.trace.jsonl
